# -----------------------------------------------------------------------------
# EL BÚHO DORADO BARBERÍA - CONFIGURACIÓN DE ENTORNOS & APIS
# -----------------------------------------------------------------------------

# 1. SUPABASE (Database, Auth, Realtime & Storage)
# Obtén estas claves en: https://app.supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. RESEND (Email transaccional al dueño) - SOLO EN SERVIDOR
# Obtén tu API Key en: https://resend.com -> API Keys
# IMPORTANTE: claves sin prefijo VITE_ solo viven en server/index.ts, NUNCA en el frontend.
RESEND_API_KEY=re_123456789...
OWNER_EMAIL=dueno@elbuho.com

# 3. WHATSAPP CLOUD API (Notificaciones de reservas al dueño) - SOLO EN SERVIDOR
# Obtén credenciales en: https://developers.facebook.com/apps -> WhatsApp
# WHATSAPP_TOKEN: System User Access Token / Permanent Token
# WHATSAPP_PHONE_ID: ID del número de teléfono de la empresa (en API Setup)
# OWNER_PHONE: teléfono que recibe las alertas en formato internacional, sin '+' (ej: 5493414362880)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_API_VERSION=v21.0
OWNER_PHONE=5493414362880

# 4. MERCADO PAGO (Cobro de Señas)
# Obtén tus credenciales en: https://www.mercadopago.com.ar/developers
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key-aqui

# 5. OPENAI (Visión Artificial - Análisis Facial Real) - SOLO EN SERVIDOR
# Obtén tu API Key en: https://platform.openai.com/api-keys
# IMPORTANTE: esta clave solo debe vivir en el servidor (server/index.ts), NUNCA en el frontend.
OPENAI_API_KEY=sk-proj-tu-api-key-aqui
